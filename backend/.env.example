# Server
PORT=5000
NODE_ENV=development

# CORS - the exact frontend origin (required for cookies to work cross-site)
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Database (required) ---
# Any hosted Postgres works: Neon, Supabase, Render, Railway, RDS, etc.
DATABASE_URL=postgresql://user:password@host:5432/csap?schema=public

# --- User authentication ---
# Long random string - used to sign regular user session cookies.
AUTH_SECRET=change-this-to-a-long-random-string
AUTH_SESSION_TTL=7d

# --- Admin authentication (fully separate from user auth) ---
# A different long random string - used to sign admin session cookies.
ADMIN_AUTH_SECRET=change-this-to-a-different-long-random-string
ADMIN_SESSION_TTL=8h

# One-time admin bootstrap credentials, consumed by `npm run prisma:seed`.
# The plaintext password is only used once, to create the hashed admin
# record - it is never stored or logged. Change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
