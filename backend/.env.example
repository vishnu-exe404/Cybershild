# Server
PORT=5000
NODE_ENV=development

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Auth (protects the /api/analytics dashboard behind a login)
# Change these before deploying anywhere public.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=2h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Database
# This starter uses a local JSON file store (see backend/config/database.js).
# To move to a hosted database later, set DB_DRIVER and connection details,
# then implement the matching driver in config/database.js without changing
# any other file (models/analysisModel.js is the only consumer).
DB_DRIVER=json-file
DB_FILE_PATH=./data/store.json

# Example for a future hosted Postgres/Mongo setup (not used by json-file driver):
# DATABASE_URL=postgres://user:password@host:5432/csap
# MONGODB_URI=mongodb+srv://user:password@cluster/csap
